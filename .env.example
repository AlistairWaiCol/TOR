# --- Auth -------------------------------------------------------------------
# Two shared passcodes, no individual accounts.
# PLAYER = full read/write on everything. GM = adds GM-only controls.
PLAYER_PASSCODE=changeme
GM_PASSCODE=changeme-gm

# Secret used to sign the session cookie. Change it for anything non-local.
SESSION_SECRET=dev-secret-change-me

# --- Discord ----------------------------------------------------------------
# Optional. If unset or empty the app silently skips posting; nothing breaks.
DISCORD_WEBHOOK_URL=

# --- Database ---------------------------------------------------------------
# Local dev uses SQLite. When moving to Postgres (Railway), set DATABASE_URL to
# the postgres:// connection string and switch DB_CLIENT to "pg".
DB_CLIENT=sqlite
DATABASE_URL=file:./data/one-ring.db

# --- Server -----------------------------------------------------------------
PORT=3001
# Vite dev server origin, allowed through CORS in development.
CLIENT_ORIGIN=http://localhost:5173
